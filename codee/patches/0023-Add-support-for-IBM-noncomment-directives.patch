+================================================================================
+IBM @process
+================================================================================
+
+@PROCESS noopt
+@PROCESS NOOPTimize
+@PROCESS smp=noopt
+@PROCESS SPILL(564)
+@PROCESS SPILLSIZE(5000)
+@process NOHOT
+@process HOT
+@process HOT(NOVECTOR)
+@process STRICT
+@process STRICT(precision)
+@process NOSTRICT
+@process HOT(NOVECTOR) NOSTRICT
+#ifdef __xlC__
+@process nohot
+@process hot
+#endif
+
+program t
+  print *, "Hi"
+end program
+
+! By IBM compiler rules, @PROCESS only appears before statements, but I guess this doesn't hurt
+@process HOT
+
