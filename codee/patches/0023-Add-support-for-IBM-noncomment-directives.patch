+================================================================================
+IBM eject
+================================================================================
+
+eject
+program t
+  type :: t_pair
+    integer :: i = 1
+    eject
+    real :: x = 0.5
+  end type
+
+  eject
+  if (.TRUE.) print *, ""
+
+  contains
+
+  eject
+  subroutine b
+  end subroutine
+  eject
+
+end program
+eject
